# 本地密钥配置模板
# 使用方法：复制本文件为 application-local.yml 并填入真实值（该文件不入库）
# application.yml 通过 spring.config.import 自动引入 application-local.yml
spring:
  ai:
    dashscope:
      api-key: 你的-DashScope-API-Key

# 语音面试（可选覆盖）：默认复用 DASHSCOPE_API_KEY 环境变量，仅在使用独立密钥时配置
# interview:
#   voice:
#     enabled: true
#     asr:
#       api-key: 你的-ASR-API-Key
#     tts:
#       api-key: 你的-TTS-API-Key
